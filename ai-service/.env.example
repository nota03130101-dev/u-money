# Local-only example. Production must set APP_ENV=production and MOCK_MODE=false.
APP_ENV=development

# true: use local fixed results and do not call a model API.
MOCK_MODE=true

# Qwen through Alibaba Cloud Model Studio's OpenAI-compatible endpoint.
# Copy the API Host shown when you create your Beijing-region key. Do not put a real key here.
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=qwen-flash

# Required only when MOCK_MODE=false. The service validates the current user
# through Supabase Auth and never uses a service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://nota03130101-dev.github.io
MODEL_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=20
MAX_TEXT_LENGTH=1000

# Use a long random server-only value in production. Do not put it in the frontend.
LOG_HASH_KEY=
PARSE_PER_MINUTE_LIMIT=5
PARSE_PER_DAY_LIMIT=30
MONTHLY_SUMMARY_LIMIT=3
MONTHLY_SUMMARY_WINDOW_SECONDS=600
